--[[
IA - INSTRUCCION RAPIDA v1.0

Este archivo es un loader de iconos para Roblox.

COMO USARLO:
local IL = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/BladexDevX/loader/refs/heads/main/loader"
))()

local ICONS = {"settings", "house", "square-terminal"}
local icons = IL.Load(ICONS)

local image = Instance.new("ImageLabel")
image.BackgroundTransparency = 1
image.Size = UDim2.fromOffset(24, 24)
image.Image = icons.settings or ""
image.Parent = frame

REGLAS PARA IA:
- Usa solamente nombres de iconos.
- NO escribas rbxassetid:// manualmente.
- NO generes PNG.
- NO generes SVG.
- NO uses emojis.
- NO uses glifos Unicode como sustitutos.
- NO uses placeholders de Roblox.
- NO inventes IDs.
- Usa IL.Load({"icon1", "icon2"}) para precargar los iconos.
- El loader busca automaticamente en las fuentes disponibles.
- El loader guarda solamente los iconos solicitados.
- Si un icono no existe, devuelve nil y no inventa un reemplazo.
- Puedes usar IL.MakeIcon(nombre, tamano, parent).

IMPORTANTE:
La version actual del repositorio contiene el archivo:
Icons bladex.lua

Ese archivo actualmente contiene:
house
square-terminal
gamepad-2
settings
bladex-hud-logo

Para que otros nombres funcionen, deben existir en alguna fuente de iconos
del repositorio. El loader no inventa IDs.

VERSION: 4.0.0
--]]

local HttpService = game:GetService("HttpService")

local BASE_URL = "https://raw.githubusercontent.com/BladexDevX/loader/refs/heads/main/"
local API_URL = "https://api.github.com/repos/BladexDevX/loader/contents/"
local CACHE_DIR = "Bladex/assets/"
local CACHE_TTL = 86400

local SOURCES = {
    {name = "bladex", path = "Icons%20bladex.lua", type = "icon"},
    {name = "lucide", path = "Icons/lucide.lua", type = "icon"},
    {name = "solar", path = "Icons/solar.lua", type = "icon"},
    {name = "gravity", path = "Icons/gravity.lua", type = "icon"},
    {name = "fluent", path = "Icons/fluent.lua", type = "icon"},
    {name = "material", path = "Icons/material.lua", type = "icon"},
    {name = "sfsymbols", path = "Icons/sfsymbols.lua", type = "icon"},
    {name = "craft", path = "Icons/craft.lua", type = "icon"},
    {name = "geist", path = "Icons/geist.lua", type = "icon"},
}

local IconLoader = {
    version = "4.0.0",
    loaded = {},
    sourceData = {},
    loading = {},
    errors = {},
    requested = {},
    aliases = {
        home = "house",
        terminal = "square-terminal",
        gamepad = "gamepad-2",
        logo = "bladex-hud-logo",
    },
    ready = false,
    _waiters = {},
}

local function fileExists(path)
    return type(isfile) == "function" and isfile(path)
end

local function dirExists(path)
    return type(isfolder) == "function" and isfolder(path)
end

local function canWrite()
    return type(writefile) == "function" and type(readfile) == "function"
end

local function ensureDir(dir)
    if not canWrite() then
        return false
    end

    if dirExists(dir) then
        return true
    end

    local current = ""

    for part in dir:gmatch("[^/]+") do
        current = current == "" and part or current .. "/" .. part

        if not dirExists(current) then
            local ok = pcall(makefolder, current)
            if not ok and not dirExists(current) then
                return false
            end
        end
    end

    return dirExists(dir)
end

local function log(level, message, ...)
    local text = message

    if select("#", ...) > 0 then
        local ok, formatted = pcall(string.format, message, ...)
        if ok then
            text = formatted
        end
    end

    local line = "[IconLoader][" .. tostring(level) .. "] " .. tostring(text)

    if level == "ERROR" or level == "WARN" then
        if type(warn) == "function" then
            warn(line)
        elseif type(print) == "function" then
            print(line)
        end
    elseif type(print) == "function" then
        print(line)
    end
end

local function normalizeKey(value)
    local text = tostring(value or ""):lower()
    text = text:gsub("[%s_%-]+", "")
    return text
end

local function cacheKey(name)
    return normalizeKey(name):gsub("[^%w]", "")
end

local function iconCachePath(name)
    return CACHE_DIR .. "icon_" .. cacheKey(name) .. ".json"
end

local function readIconCache(name)
    if not canWrite() then
        return nil
    end

    local path = iconCachePath(name)

    if not fileExists(path) then
        return nil
    end

    local ok, raw = pcall(readfile, path)

    if not ok or type(raw) ~= "string" or raw == "" then
        return nil
    end

    local okJson, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if not okJson or type(data) ~= "table" then
        return nil
    end

    local timestamp = tonumber(data.timestamp) or 0

    if os.time() - timestamp > CACHE_TTL then
        return nil
    end

    if type(data.name) ~= "string" or type(data.id) ~= "string" then
        return nil
    end

    return {
        name = data.name,
        id = data.id,
        source = data.source,
        timestamp = timestamp,
    }
end

local function writeIconCache(name, id, source)
    if not canWrite() then
        return false
    end

    if not ensureDir(CACHE_DIR) then
        return false
    end

    local payload = {
        timestamp = os.time(),
        name = tostring(name),
        id = tostring(id),
        source = tostring(source or ""),
    }

    local ok = pcall(function()
        writefile(iconCachePath(name), HttpService:JSONEncode(payload))
    end)

    return ok
end

local function removeIconCache(name)
    if type(delfile) ~= "function" then
        return false
    end

    local path = iconCachePath(name)

    if not fileExists(path) then
        return true
    end

    return pcall(delfile, path)
end

local function classifyError(value)
    local text = tostring(value or ""):lower()

    if text:find("404", 1, true) or text:find("not found", 1, true) then
        return "NOT_FOUND"
    end

    if text:find("403", 1, true) or text:find("forbidden", 1, true) then
        return "FORBIDDEN"
    end

    if text:find("429", 1, true) or text:find("rate limit", 1, true) then
        return "RATE_LIMIT"
    end

    if text:find("timeout", 1, true) then
        return "TIMEOUT"
    end

    if text == "" then
        return "EMPTY"
    end

    return "UNKNOWN"
end

local function sourceUrl(source)
    return BASE_URL .. source.path
end

local function decodeSource(raw, sourceName)
    local ok, result = pcall(function()
        local fn = loadstring(raw)

        if type(fn) ~= "function" then
            error("LOADSTRING_FAILED")
        end

        return fn()
    end)

    if not ok then
        IconLoader.errors[sourceName] = classifyError(result)
        log("ERROR", "Fuente '%s' invalida: %s", sourceName, IconLoader.errors[sourceName])
        return nil
    end

    if type(result) ~= "table" then
        IconLoader.errors[sourceName] = "INVALID_TABLE"
        log("ERROR", "Fuente '%s' no devolvio una tabla", sourceName)
        return nil
    end

    return result
end

local function fetchSource(source)
    local sourceName = source.name

    if IconLoader.sourceData[sourceName] then
        return IconLoader.sourceData[sourceName]
    end

    if IconLoader.loading[sourceName] then
        local elapsed = 0

        while IconLoader.loading[sourceName] and elapsed < 10 do
            task.wait(0.1)
            elapsed = elapsed + 0.1
        end

        return IconLoader.sourceData[sourceName]
    end

    IconLoader.loading[sourceName] = true
    IconLoader.errors[sourceName] = nil

    local ok, raw = pcall(function()
        return game:HttpGet(sourceUrl(source))
    end)

    if not ok or type(raw) ~= "string" or #raw < 5 then
        IconLoader.errors[sourceName] = classifyError(raw)
        IconLoader.loading[sourceName] = nil
        return nil
    end

    local data = decodeSource(raw, sourceName)

    IconLoader.loading[sourceName] = nil

    if data then
        IconLoader.sourceData[sourceName] = data
        log("INFO", "Fuente '%s' cargada", sourceName)
    end

    return data
end

local function getSourceByName(name)
    for _, source in ipairs(SOURCES) do
        if source.name == name then
            return source
        end
    end

    return nil
end

local function findInData(data, name)
    if type(data) ~= "table" then
        return nil
    end

    local requested = tostring(name or "")
    local normalized = normalizeKey(requested)

    if data[requested] then
        return data[requested], requested
    end

    if data[normalized] then
        return data[normalized], normalized
    end

    for key, value in pairs(data) do
        if normalizeKey(key) == normalized then
            return value, key
        end
    end

    return nil
end

local function resolveAlias(name)
    local key = normalizeKey(name)

    for alias, target in pairs(IconLoader.aliases) do
        if normalizeKey(alias) == key then
            return target
        end
    end

    return name
end

local function isAssetId(value)
    return type(value) == "string"
        and value:match("^rbxassetid://%d+$") ~= nil
end

local function loadOne(name, sourceList)
    if type(name) ~= "string" or name == "" then
        return nil
    end

    local requestedName = name
    local lookupName = resolveAlias(name)

    local cached = readIconCache(requestedName)

    if cached and isAssetId(cached.id) then
        IconLoader.loaded[requestedName] = cached.id
        IconLoader.requested[requestedName] = true
        return cached.id
    end

    local sources = sourceList or SOURCES

    for _, source in ipairs(sources) do
        local data = fetchSource(source)
        local id, actualName = findInData(data, lookupName)

        if id and isAssetId(tostring(id)) then
            id = tostring(id)

            IconLoader.loaded[requestedName] = id
            IconLoader.requested[requestedName] = true

            writeIconCache(requestedName, id, source.name)

            log("INFO", "Icono '%s' encontrado en '%s'", requestedName, source.name)

            return id, actualName, source.name
        end
    end

    IconLoader.requested[requestedName] = true
    IconLoader.errors["icon:" .. requestedName] = "NOT_FOUND"

    log("WARN", "Icono '%s' no encontrado", requestedName)

    return nil
end

function IconLoader.Get(pack, name)
    if type(pack) ~= "string" or type(name) ~= "string" then
        return nil
    end

    local source = getSourceByName(pack)

    if not source then
        IconLoader.errors[pack] = "NOT_FOUND"
        return nil
    end

    return loadOne(name, {source})
end

function IconLoader.Find(name)
    if type(name) ~= "string" or name == "" then
        return nil
    end

    if IconLoader.loaded[name] then
        return IconLoader.loaded[name]
    end

    return loadOne(name)
end

function IconLoader.GetAny(list, name)
    if type(list) ~= "table" or type(name) ~= "string" then
        return nil
    end

    local sources = {}

    for _, pack in ipairs(list) do
        local source = getSourceByName(pack)

        if source then
            sources[#sources + 1] = source
        end
    end

    return loadOne(name, sources)
end

function IconLoader.Load(names)
    local result = {}

    if type(names) == "string" then
        names = {names}
    end

    if type(names) ~= "table" then
        return result
    end

    for _, name in ipairs(names) do
        if type(name) == "string" and name ~= "" then
            result[name] = IconLoader.Find(name)
        end
    end

    return result
end

function IconLoader.MakeIcon(name, size, parent)
    size = tonumber(size) or 24

    local image = Instance.new("ImageLabel")
    image.Name = "Icon_" .. tostring(name)
    image.Size = UDim2.fromOffset(size, size)
    image.BackgroundTransparency = 1
    image.ScaleType = Enum.ScaleType.Fit
    image.Image = IconLoader.Find(name) or ""

    if parent then
        image.Parent = parent
    end

    if image.Image == "" then
        log("WARN", "MakeIcon no pudo resolver '%s'", tostring(name))
    end

    return image
end

function IconLoader.List()
    local names = {}

    for _, source in ipairs(SOURCES) do
        names[#names + 1] = source.name
    end

    table.sort(names)

    return names
end

function IconLoader.Packs()
    local result = {}

    for _, source in ipairs(SOURCES) do
        result[source.name] = {
            type = source.type,
            path = source.path,
            loaded = IconLoader.sourceData[source.name] ~= nil,
            error = IconLoader.errors[source.name],
        }
    end

    return result
end

function IconLoader.Search(query)
    local result = {}
    local normalizedQuery = normalizeKey(query)

    if normalizedQuery == "" then
        return result
    end

    for sourceName, data in pairs(IconLoader.sourceData) do
        for name, id in pairs(data) do
            if normalizeKey(name):find(normalizedQuery, 1, true) then
                if isAssetId(tostring(id)) then
                    result[#result + 1] = {
                        pack = sourceName,
                        name = name,
                        id = tostring(id),
                    }
                end
            end
        end
    end

    return result
end

function IconLoader.Ready(timeout)
    timeout = tonumber(timeout) or 15

    local started = os.clock()

    while os.clock() - started < timeout do
        if not IconLoader.ready then
            local source = SOURCES[1]
            fetchSource(source)
            IconLoader.ready = true

            for _, callback in ipairs(IconLoader._waiters) do
                pcall(callback)
            end

            IconLoader._waiters = {}
        end

        return true
    end

    return IconLoader.ready
end

function IconLoader.Refresh(pack)
    if type(pack) ~= "string" then
        return false
    end

    local source = getSourceByName(pack)

    if not source then
        return false
    end

    IconLoader.sourceData[pack] = nil
    IconLoader.errors[pack] = nil

    for name in pairs(IconLoader.loaded) do
        local cached = readIconCache(name)

        if cached and cached.source == pack then
            IconLoader.loaded[name] = nil
            removeIconCache(name)
        end
    end

    return fetchSource(source) ~= nil
end

function IconLoader.RefreshIcon(name)
    if type(name) ~= "string" then
        return false
    end

    IconLoader.loaded[name] = nil
    IconLoader.requested[name] = nil
    IconLoader.errors["icon:" .. name] = nil

    removeIconCache(name)

    return IconLoader.Find(name) ~= nil
end

function IconLoader.Errors()
    local result = {}

    for key, value in pairs(IconLoader.errors) do
        result[key] = value
    end

    return result
end

function IconLoader.OnReady(callback)
    if type(callback) ~= "function" then
        return false
    end

    if IconLoader.ready then
        task.spawn(function()
            pcall(callback)
        end)
    else
        IconLoader._waiters[#IconLoader._waiters + 1] = callback
    end

    return true
end

function IconLoader.Help()
    return ([[
IconLoader v%s

USO:
local icons = IL.Load({"settings", "house", "square-terminal"})

FUNCIONES:
Load(names)
Find(name)
Get(pack, name)
GetAny({packs}, name)
MakeIcon(name, size, parent)
Search(query)
List()
Packs()
Ready(timeout)
Refresh(pack)
RefreshIcon(name)
Errors()
Spec()
Help()

No usa PNG, SVG, emojis, glifos ni placeholders.
Los iconos deben existir en una fuente del repositorio.
]]):format(IconLoader.version)
end

function IconLoader.Spec()
    local sources = {}

    for _, source in ipairs(SOURCES) do
        sources[source.name] = {
            path = source.path,
            type = source.type,
        }
    end

    return {
        name = "IconLoader",
        version = IconLoader.version,
        baseUrl = BASE_URL,
        cacheDir = CACHE_DIR,
        cacheMode = "individual-icons",
        sources = sources,
        aliases = IconLoader.aliases,
        functions = {
            Load = {params = {"names: table|string"}, returns = "table"},
            Find = {params = {"name: string"}, returns = "string|nil"},
            Get = {params = {"pack: string", "name: string"}, returns = "string|nil"},
            GetAny = {params = {"packs: table", "name: string"}, returns = "string|nil"},
            MakeIcon = {params = {"name: string", "size?: number", "parent?: Instance"}, returns = "ImageLabel"},
            Search = {params = {"query: string"}, returns = "table"},
            List = {params = {}, returns = "table"},
            Packs = {params = {}, returns = "table"},
            Ready = {params = {"timeout?: number"}, returns = "boolean"},
            Refresh = {params = {"pack: string"}, returns = "boolean"},
            RefreshIcon = {params = {"name: string"}, returns = "boolean"},
            Errors = {params = {}, returns = "table"},
            Spec = {params = {}, returns = "table"},
            Help = {params = {}, returns = "string"},
        },
    }
end

IconLoader.Ready(10)

log("INFO", "IconLoader v%s inicializado", IconLoader.version)

return IconLoader
