--[[
IA - INSTRUCCION RAPIDA
Usa este loader para los iconos de la UI.
Declara solamente los nombres que necesitas en ICONS.
No escribas rbxassetid:// y no indiques el pack si no es necesario.
El loader busca automaticamente cada icono y guarda solo los iconos utilizados.
Ejemplo:
local ICONS = {"search", "settings", "x"}
local icons = IL.Load(ICONS)
local icon = icons.search
VERSION: 1.0
--]]

-- Servicios y configuracion basica
local HttpService = game:GetService("HttpService")

local BASE_URL = "https://raw.githubusercontent.com/BladexDevX/loader/refs/heads/main/"
local CACHE_DIR = "Bladex/assets/"
local CACHE_TTL = 86400

-- Packs disponibles. La UI no necesita elegir uno cuando usa Load/Find.
local PACKAGES = {
    gravity   = { path = "Icons/gravity.lua",   type = "icon" },
    lucide    = { path = "Icons/lucide.lua",    type = "icon" },
    sfsymbols = { path = "Icons/sfsymbols.lua", type = "icon" },
    solar     = { path = "Icons/solar.lua",     type = "icon" },
    craft     = { path = "Icons/craft.lua",     type = "icon" },
    geist     = { path = "Icons/geist.lua",     type = "icon" },
    fluent    = { path = "Icons/fluent.lua",    type = "icon" },
    material  = { path = "Icons/material.lua",  type = "icon" },
}

-- Orden usado para buscar un icono por nombre.
local SEARCH_ORDER = {
    "lucide",
    "solar",
    "gravity",
    "fluent",
    "material",
    "sfsymbols",
    "craft",
    "geist",
}

-- Estado del loader y cache de iconos utilizados.
local IconLoader = {
    version = "4.0.0",
    loaded = {},
    loadedIcons = {},
    loading = {},
    errors = {},
    ready = false,
    _waiters = {},
}

local function fileExists(p)
    return type(isfile) == "function" and isfile(p)
end

local function dirExists(p)
    return type(isfolder) == "function" and isfolder(p)
end

local function canWrite()
    return type(writefile) == "function" and type(readfile) == "function"
end

local function ensureDir(dir)
    if not canWrite() or type(makefolder) ~= "function" then
        return false
    end

    if dirExists(dir) then
        return true
    end

    local parts = {}
    for seg in dir:gmatch("[^/]+") do
        parts[#parts + 1] = seg
    end

    local cur = ""
    for _, seg in ipairs(parts) do
        cur = cur == "" and seg or cur .. "/" .. seg
        if not dirExists(cur) then
            local ok = pcall(makefolder, cur)
            if not ok and not dirExists(cur) then
                return false
            end
        end
    end

    return dirExists(dir)
end

local function log(level, msg, ...)
    local text = select("#", ...) > 0 and string.format(msg, ...) or msg
    local line = string.format("[IconLoader][%s] %s", level, text)

    if level == "ERROR" and type(warn) == "function" then
        warn(line)
    elseif type(print) == "function" then
        print(line)
    end
end

local function classifyError(err)
    local e = tostring(err or ""):lower()

    if e:find("404", 1, true) then return "NOT_FOUND" end
    if e:find("403", 1, true) then return "FORBIDDEN" end
    if e:find("429", 1, true) then return "RATE_LIMIT" end
    if e:find("timeout", 1, true) then return "TIMEOUT" end
    if e:find("invalid", 1, true) then return "INVALID" end
    if e == "" then return "EMPTY" end

    return "UNKNOWN"
end

local function nowSec()
    return os.time()
end

local function normalizeKey(value)
    return tostring(value or ""):lower():gsub("[%s_%-]", "")
end

local function safeFileName(value)
    return tostring(value or ""):gsub("[^%w_%-]", "_")
end

local function iconCachePath(name)
    return CACHE_DIR .. "icon_" .. safeFileName(normalizeKey(name)) .. ".json"
end

local function packTempPath(pack)
    return CACHE_DIR .. "temp_" .. safeFileName(pack) .. ".json"
end

-- Lee un icono individual guardado en cache.
local function readIconCache(name)
    if not canWrite() then
        return nil
    end

    local path = iconCachePath(name)
    if not fileExists(path) then
        return nil
    end

    local ok, raw = pcall(readfile, path)
    if not ok or type(raw) ~= "string" or raw == "" then
        return nil
    end

    local ok2, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if not ok2 or type(data) ~= "table" then
        return nil
    end

    if nowSec() - (tonumber(data.__timestamp) or 0) > CACHE_TTL then
        if type(delfile) == "function" then
            pcall(delfile, path)
        end
        return nil
    end

    if type(data.name) ~= "string" or type(data.id) ~= "string" then
        return nil
    end

    return data
end

-- Guarda solamente el icono encontrado, no todo el pack.
local function writeIconCache(name, id, pack)
    if not canWrite() then
        return false
    end

    if not ensureDir(CACHE_DIR) then
        return false
    end

    local path = iconCachePath(name)

    local ok = pcall(function()
        writefile(path, HttpService:JSONEncode({
            __timestamp = nowSec(),
            name = name,
            id = id,
            pack = pack,
        }))
    end)

    return ok
end

local function deleteTempPack(pack)
    local path = packTempPath(pack)

    if fileExists(path) and type(delfile) == "function" then
        pcall(delfile, path)
    end
end

-- Toma del pack solo los nombres solicitados.
local function extractRequestedIcons(pack, data, requested)
    if type(data) ~= "table" or type(requested) ~= "table" then
        return 0
    end

    local found = 0

    for requestedName in pairs(requested) do
        local target = normalizeKey(requestedName)
        local id = nil
        local realName = requestedName

        if data[requestedName] then
            id = data[requestedName]
        elseif data[target] then
            id = data[target]
            realName = target
        else
            for key, value in pairs(data) do
                if normalizeKey(key) == target then
                    id = value
                    realName = key
                    break
                end
            end
        end

        if type(id) == "string" and id ~= "" then
            IconLoader.loadedIcons[target] = {
                name = realName,
                id = id,
                pack = pack,
            }

            writeIconCache(target, id, pack)
            found = found + 1
        end
    end

    return found
end

-- Descarga un pack solo cuando hace falta buscar un icono.
local function loadPackForRequests(pack, requested)
    if type(PACKAGES[pack]) ~= "table" then
        IconLoader.errors[pack] = "NOT_FOUND"
        return false
    end

    if type(requested) ~= "table" or next(requested) == nil then
        return false
    end

    local ok, raw = pcall(function()
        return game:HttpGet(BASE_URL .. PACKAGES[pack].path)
    end)

    if not ok or type(raw) ~= "string" or #raw < 2 then
        IconLoader.errors[pack] = classifyError(raw)
        log("ERROR", "Fallo descargando '%s': %s", pack, IconLoader.errors[pack])
        return false
    end

    local ok2, result = pcall(function()
        local fn = loadstring(raw)
        if type(fn) ~= "function" then
            error("loadstring devolvio nil")
        end
        return fn()
    end)

    if not ok2 or type(result) ~= "table" then
        IconLoader.errors[pack] = classifyError(result)
        log("ERROR", "Pack '%s' invalido: %s", pack, IconLoader.errors[pack])
        return false
    end

    local found = extractRequestedIcons(pack, result, requested)

    result = nil
    raw = nil

    deleteTempPack(pack)

    IconLoader.loaded[pack] = true

    log("INFO", "Pack '%s': %d iconos solicitados encontrados", pack, found)

    return found > 0
end

-- Carga solo los nombres indicados por la UI.
local function loadRequestedIcons(names)
    local requested = {}

    if type(names) == "string" then
        requested[normalizeKey(names)] = names
    elseif type(names) == "table" then
        for _, name in ipairs(names) do
            if type(name) == "string" and name ~= "" then
                requested[normalizeKey(name)] = name
            end
        end
    end

    if next(requested) == nil then
        return {}
    end

    local remaining = {}

    for normalized, original in pairs(requested) do
        local cached = readIconCache(normalized)

        if cached then
            IconLoader.loadedIcons[normalized] = {
                name = cached.name or original,
                id = cached.id,
                pack = cached.pack,
            }
        else
            remaining[normalized] = original
        end
    end

    for _, pack in ipairs(SEARCH_ORDER) do
        if next(remaining) == nil then
            break
        end

        loadPackForRequests(pack, remaining)

        for normalized in pairs(remaining) do
            if IconLoader.loadedIcons[normalized] then
                remaining[normalized] = nil
            end
        end
    end

    for normalized, original in pairs(remaining) do
        IconLoader.errors[normalized] = "ICON_NOT_FOUND"
        log("WARN", "Icono '%s' no encontrado", tostring(original))
    end

    local result = {}

    for normalized, original in pairs(requested) do
        local item = IconLoader.loadedIcons[normalized]

        if item then
            result[original] = item.id
        end
    end

    return result
end

-- Uso principal: IL.Load({"search", "settings", "x"})
function IconLoader.Load(names)
    return loadRequestedIcons(names)
end

-- Obtiene un icono indicando el pack directamente.
function IconLoader.Get(pack, name)
    if type(pack) ~= "string" or type(name) ~= "string" then
        return nil
    end

    local normalized = normalizeKey(name)
    local cached = IconLoader.loadedIcons[normalized]

    if cached and (pack == "" or cached.pack == pack) then
        return cached.id
    end

    local requested = {
        [normalized] = name,
    }

    loadPackForRequests(pack, requested)

    local item = IconLoader.loadedIcons[normalized]

    if item and item.pack == pack then
        return item.id
    end

    return nil
end

-- Busca automaticamente el icono por nombre.
function IconLoader.Find(name)
    if type(name) ~= "string" then
        return nil
    end

    local normalized = normalizeKey(name)
    local cached = IconLoader.loadedIcons[normalized]

    if cached then
        return cached.id
    end

    local result = loadRequestedIcons({name})
    return result[name]
end

-- Busca el icono solo en los packs indicados.
function IconLoader.GetAny(list, name)
    if type(list) ~= "table" or type(name) ~= "string" then
        return nil
    end

    local normalized = normalizeKey(name)
    local cached = IconLoader.loadedIcons[normalized]

    if cached then
        for _, pack in ipairs(list) do
            if cached.pack == pack then
                return cached.id
            end
        end
    end

    local requested = {
        [normalized] = name,
    }

    for _, pack in ipairs(list) do
        if type(pack) == "string" and PACKAGES[pack] then
            loadPackForRequests(pack, requested)

            local item = IconLoader.loadedIcons[normalized]
            if item and item.pack == pack then
                return item.id
            end
        end
    end

    return nil
end

function IconLoader.List()
    local out = {}

    for name in pairs(PACKAGES) do
        out[#out + 1] = name
    end

    table.sort(out)
    return out
end

function IconLoader.Packs()
    local out = {}

    for name, def in pairs(PACKAGES) do
        out[name] = {
            type = def.type,
            path = def.path,
            loaded = IconLoader.loaded[name] == true,
            error = IconLoader.errors[name],
        }
    end

    return out
end

function IconLoader.Search(query)
    local q = normalizeKey(query)

    if q == "" then
        return {}
    end

    local out = {}

    for normalized, item in pairs(IconLoader.loadedIcons) do
        if normalized:find(q, 1, true) then
            out[#out + 1] = {
                pack = item.pack,
                name = item.name,
                id = item.id,
            }
        end
    end

    table.sort(out, function(a, b)
        return tostring(a.name) < tostring(b.name)
    end)

    return out
end

function IconLoader.Help()
    return ([[
IconLoader v%s

Load({"search", "settings", "copy", "x"})
Get(pack, name)
Find(name)
GetAny({"lucide", "solar"}, name)
List()
Packs()
Search(query)
Help()
Spec()
Ready(timeout)
Refresh(pack)
MakeIcon(name, size, parent)
Errors()

Los iconos se solicitan solo por nombre.
El loader busca automaticamente el pack.
Solo se guarda en cache el icono utilizado.
Packs: %s
]]):format(
        IconLoader.version,
        table.concat(IconLoader.List(), ", ")
    )
end

function IconLoader.Spec()
    return {
        name = "IconLoader",
        version = IconLoader.version,
        packages = (function()
            local p = {}

            for name, def in pairs(PACKAGES) do
                p[name] = {
                    path = def.path,
                    type = def.type,
                }
            end

            return p
        end)(),
        functions = {
            Load     = { params = {"names: table|string"}, returns = "table" },
            Get      = { params = {"pack: string", "name: string"}, returns = "string|nil" },
            Find     = { params = {"name: string"}, returns = "string|nil" },
            GetAny   = { params = {"list: table", "name: string"}, returns = "string|nil" },
            List     = { params = {}, returns = "table" },
            Packs    = { params = {}, returns = "table" },
            Search   = { params = {"query: string"}, returns = "table" },
            Help     = { params = {}, returns = "string" },
            Spec     = { params = {}, returns = "table" },
            Ready    = { params = {"names: table|string"}, returns = "bool" },
            Refresh  = { params = {"pack: string"}, returns = "bool" },
            MakeIcon = { params = {"name", "size?", "parent?"}, returns = "ImageLabel" },
            Errors   = { params = {}, returns = "table" },
        },
    }
end

function IconLoader.Ready(names, timeout)
    if type(names) == "number" then
        timeout = names
        names = nil
    end

    timeout = timeout or 15

    if names == nil then
        IconLoader.ready = true

        for _, cb in ipairs(IconLoader._waiters) do
            pcall(cb, true)
        end

        IconLoader._waiters = {}
        return true
    end

    local done = false
    local result = {}

    task.spawn(function()
        result = loadRequestedIcons(names)
        done = true
    end)

    local started = os.clock()

    while not done and os.clock() - started < timeout do
        task.wait()
    end

    IconLoader.ready = done

    for _, cb in ipairs(IconLoader._waiters) do
        pcall(cb, done)
    end

    IconLoader._waiters = {}

    return done
end

function IconLoader.Refresh(pack)
    if not PACKAGES[pack] then
        return false
    end

    IconLoader.loaded[pack] = nil
    IconLoader.errors[pack] = nil

    local prefix = CACHE_DIR .. "icon_"

    if canWrite() and type(listfiles) == "function" then
        local ok, files = pcall(listfiles, CACHE_DIR)

        if ok and type(files) == "table" and type(delfile) == "function" then
            for _, path in ipairs(files) do
                local base = tostring(path):match("([^/]+)$") or ""

                if base:sub(1, #prefix - #CACHE_DIR) == "" then
                    local normalized = base:match("^icon_(.+)%.json$")

                    if normalized then
                        local cached = readIconCache(normalized)

                        if cached and cached.pack == pack then
                            pcall(delfile, path)
                            IconLoader.loadedIcons[normalized] = nil
                        end
                    end
                end
            end
        end
    end

    return true
end

-- Crea un ImageLabel usando el icono por nombre.
function IconLoader.MakeIcon(name, size, parent)
    size = tonumber(size) or 24

    local id = IconLoader.Find(name)

    if not id then
        id = "rbxasset://textures/ui/GuiImagePlaceholder.png"
    end

    local img = Instance.new("ImageLabel")
    img.Name = "Icon_" .. tostring(name)
    img.Image = id
    img.Size = UDim2.fromOffset(size, size)
    img.BackgroundTransparency = 1
    img.ScaleType = Enum.ScaleType.Fit
    img.ImageColor3 = Color3.fromRGB(255, 255, 255)

    if parent then
        img.Parent = parent
    end

    task.spawn(function()
        local started = os.clock()

        while not img.IsLoaded and os.clock() - started < 5 do
            task.wait(0.1)
        end

        if not img.IsLoaded then
            img.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
            log("WARN", "Icono '%s' no cargo", tostring(name))
        end
    end)

    return img
end

function IconLoader.Errors()
    return IconLoader.errors
end

function IconLoader.OnReady(callback)
    if type(callback) ~= "function" then
        return
    end

    if IconLoader.ready then
        pcall(callback, true)
    else
        IconLoader._waiters[#IconLoader._waiters + 1] = callback
    end
end

-- El loader no carga packs automaticamente al iniciar.
log("INFO", "IconLoader v%s inicializado. Carga selectiva activada.", IconLoader.version)

return IconLoader
